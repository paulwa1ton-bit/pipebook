{
  "expo": {
    "name": "PipeBook",
    "slug": "pipebook",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pipebook",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pipebook.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PipeBook uses your photo library so you can add your business logo to invoices and quotes."
      }
    },
    "android": {
      "package": "com.pipebook.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "PipeBook uses your photo library so you can add your business logo to invoices and quotes."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "firebase": {
        "apiKey": "REPLACE_ME",
        "authDomain": "REPLACE_ME",
        "projectId": "REPLACE_ME",
        "storageBucket": "REPLACE_ME",
        "messagingSenderId": "REPLACE_ME",
        "appId": "REPLACE_ME"
      }
    }
  }
}
