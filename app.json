{
  "expo": {
    "name": "PipeBook",
    "slug": "pipebook",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pipebook",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pipebook.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PipeBook uses your photo library so you can add your business logo to invoices and quotes."
      }
    },
    "android": {
      "package": "com.pipebook.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5EDDD"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "PipeBook uses your photo library so you can add your business logo to invoices and quotes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F8E9C8"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "firebase": {
        "apiKey": "AIzaSyCbPwNM2HBp_T6pYiLKmAby_6OA6_toaeY",
        "authDomain": "pipebook-73016.firebaseapp.com",
        "projectId": "pipebook-73016",
        "storageBucket": "pipebook-73016.firebasestorage.app",
        "messagingSenderId": "494892814503",
        "appId": "1:494892814503:web:b06af8d2f2029cc3990b82"
      }
    },
    "icon": "./assets/icon.png"
  }
}
